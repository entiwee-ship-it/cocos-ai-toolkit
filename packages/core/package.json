{
  "name": "@cocos-ai/core",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./prefab-graph": {
      "types": "./dist/prefab-graph.d.ts",
      "import": "./dist/prefab-graph.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cocos-ai/protocol": "0.2.5",
    "pngjs": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5"
  }
}
