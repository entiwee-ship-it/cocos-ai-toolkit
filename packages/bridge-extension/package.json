{
  "package_version": 2,
  "name": "cocos-ai-bridge",
  "title": "Cocos AI Bridge",
  "version": "0.1.12",
  "description": "Cocos Creator 3.8.x editor bridge for the Cocos AI probe server",
  "author": "李威-Enti",
  "date": "2026-07-17",
  "platform": [
    "win32"
  ],
  "main": "./dist/main.js",
  "editor": ">=3.8.0 <3.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "contributions": {
    "scene": {
      "script": "./dist/scene.js"
    },
    "messages": {
      "probe-editor-state": { "methods": ["probe-editor-state"] },
      "probe-assets": { "methods": ["probe-assets"] },
      "probe-asset-index": { "methods": ["probe-asset-index"] },
      "probe-document-snapshot": { "methods": ["probe-document-snapshot"] },
      "probe-hierarchy": { "methods": ["probe-hierarchy"] },
      "probe-node": { "methods": ["probe-node"] },
      "probe-component": { "methods": ["probe-component"] },
      "probe-prefab": { "methods": ["probe-prefab"] },
      "probe-undo-save-prepare": { "methods": ["probe-undo-save-prepare"] },
      "probe-undo-save-confirm": { "methods": ["probe-undo-save-confirm"] },
      "probe-undo-save-status": { "methods": ["probe-undo-save-status"] },
      "probe-write-prepare": { "methods": ["probe-write-prepare"] },
      "probe-write-confirm": { "methods": ["probe-write-confirm"] },
      "probe-transaction-status": { "methods": ["probe-transaction-status"] },
      "probe-transaction-list": { "methods": ["probe-transaction-list"] },
      "probe-transaction-rollback": { "methods": ["probe-transaction-rollback"] }
    }
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cocos/creator-types": "3.8.7",
    "@types/ws": "^8.18.1"
  }
}
