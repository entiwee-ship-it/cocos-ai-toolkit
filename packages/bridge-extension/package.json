{
  "package_version": 2,
  "name": "cocos-ai-bridge",
  "title": "Cocos AI Bridge",
  "version": "0.6.6",
  "description": "i18n:cocos-ai-bridge.description",
  "author": "李威-Enti",
  "date": "2026-09-01",
  "platform": [
    "win32"
  ],
  "main": "./dist/main.js",
  "editor": ">=3.8.0 <3.9.0",
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && node ../../scripts/write-bridge-build-info.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "contributions": {
    "scene": {
      "script": "./dist/scene.js"
    },
    "messages": {
      "probe-editor-state": {
        "methods": [
          "probe-editor-state"
        ]
      },
      "probe-assets": {
        "methods": [
          "probe-assets"
        ]
      },
      "probe-asset-index": {
        "methods": [
          "probe-asset-index"
        ]
      },
      "probe-hierarchy": {
        "methods": [
          "probe-hierarchy"
        ]
      },
      "probe-node": {
        "methods": [
          "probe-node"
        ]
      },
      "probe-component": {
        "methods": [
          "probe-component"
        ]
      },
      "probe-prefab": {
        "methods": [
          "probe-prefab"
        ]
      }
    }
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@cocos/creator-types": "3.8.8",
    "@types/ws": "^8.18.1"
  }
}
