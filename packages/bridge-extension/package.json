{
  "package_version": 2,
  "name": "cocos-ai-bridge",
  "title": "Cocos AI Bridge",
  "version": "0.9.3",
  "description": "i18n:cocos-ai-bridge.description",
  "author": "Enti",
  "date": "2026-09-08",
  "platform": [
    "win32"
  ],
  "main": "./dist/main.js",
  "editor": ">=3.8.0 <3.9.0",
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && node ../../scripts/build-native-window-host.mjs && node ../../scripts/write-bridge-build-info.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "panels": {
    "default": {
      "title": "i18n:cocos-ai-bridge.panel_title",
      "type": "simple",
      "main": "./dist/panels/default",
      "size": {
        "min-width": 460,
        "min-height": 360,
        "width": 760,
        "height": 620
      }
    },
    "workbench": {
      "title": "i18n:cocos-ai-bridge.workbench_title",
      "type": "simple",
      "main": "./dist/panels/workbench",
      "size": {
        "min-width": 1000,
        "min-height": 640,
        "width": 1500,
        "height": 860
      }
    }
  },
  "contributions": {
    "preview": {
      "simulator": {
        "methods": "./dist/simulator-runtime-preview.js",
        "hooks": {
          "settings": "onSettingsSimulator"
        }
      }
    },
    "server": "./dist/simulator-runtime-server.js",
    "menu": [
      {
        "path": "Cocos AI",
        "label": "i18n:cocos-ai-bridge.open_panel",
        "message": "open-panel"
      },
      {
        "path": "Cocos AI",
        "label": "i18n:cocos-ai-bridge.open_workbench",
        "message": "open-workbench"
      }
    ],
    "scene": {
      "script": "./dist/scene.js"
    },
    "messages": {
      "open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "open-workbench": {
        "methods": [
          "openWorkbench"
        ]
      },
      "workbench-url": {
        "methods": [
          "queryWorkbenchUrl"
        ]
      },
      "workbench-close": {
        "methods": [
          "closeWorkbench"
        ]
      },
      "manager-state": {
        "methods": [
          "queryManagerState"
        ]
      },
      "open-extension-manager": {
        "methods": [
          "openExtensionManager"
        ]
      },
      "probe-editor-state": {
        "methods": [
          "probe-editor-state"
        ]
      },
      "probe-assets": {
        "methods": [
          "probe-assets"
        ]
      },
      "probe-asset-index": {
        "methods": [
          "probe-asset-index"
        ]
      },
      "probe-hierarchy": {
        "methods": [
          "probe-hierarchy"
        ]
      },
      "probe-node": {
        "methods": [
          "probe-node"
        ]
      },
      "probe-component": {
        "methods": [
          "probe-component"
        ]
      },
      "probe-prefab": {
        "methods": [
          "probe-prefab"
        ]
      }
    }
  },
  "devDependencies": {
    "@cocos/creator-types": "3.8.8"
  }
}
