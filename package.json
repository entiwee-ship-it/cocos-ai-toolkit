{
  "name": "cocos-ai-toolkit",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=20.19 <26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "codex:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-codex-mcp.ps1",
    "codex:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-codex-mcp.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
